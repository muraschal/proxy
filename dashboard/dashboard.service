[Unit]
Description=proxy-ch Live Traffic Dashboard
After=network.target 3proxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/proxy-dashboard
ExecStart=/opt/proxy-dashboard/venv/bin/python dashboard.py
Environment=LOG_DIR=/usr/local/3proxy/logs
Environment=DASHBOARD_PORT=8080
Environment=ACTIVE_WINDOW_SECONDS=300
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
